#!/bin/sh
set -eu

# Local binary hooks run as separate processes in live-build 3.0; load the
# generated values needed to render the menu instead of relying on exports.
. ./config/binary

# Syslinux 6 COM32 menus require these modules beside vesamenu.c32. The old
# live-build template predates that split and copies only vesamenu itself.
install -m 0644 chroot/usr/lib/syslinux/modules/bios/ldlinux.c32 binary/isolinux/
install -m 0644 chroot/usr/lib/syslinux/modules/bios/libcom32.c32 binary/isolinux/
install -m 0644 chroot/usr/lib/syslinux/modules/bios/libutil.c32 binary/isolinux/

# live-build 3.0's Syslinux code hard-codes binary/live even when its own
# linux-image stage correctly uses binary/casper. Select the kernel required by
# Noble's linux-image-generic metapackage and expose stable Casper filenames
# used by the static bootloader configuration.
kernel_package="$(
    dpkg-query --admindir="$PWD/chroot/var/lib/dpkg" \
        -W -f='${Depends}\n' linux-image-generic |
        tr ',' '\n' |
        sed -n 's/^[[:space:]]*\(linux-image-[^[:space:]()]\+\).*/\1/p' |
        head -n 1
)"
test -n "$kernel_package"
kernel_version="${kernel_package#linux-image-}"
install -m 0644 "chroot/boot/vmlinuz-${kernel_version}" binary/casper/vmlinuz
install -m 0644 "chroot/boot/initrd.img-${kernel_version}" binary/casper/initrd.img

# The static-live.cfg branch in Ubuntu's legacy live-build 3.0 references the
# never-defined variable _SUFFIX and consequently runs sed against /live.cfg.
# Keep our source under an unrecognized name so lb_binary_syslinux skips that
# broken branch, then render the real menu here after the Syslinux stage.
sed -e "s|@LB_BOOTAPPEND_LIVE@|${LB_BOOTAPPEND_LIVE}|g" \
    -e "s|@LB_BOOTAPPEND_FAILSAFE@|${LB_BOOTAPPEND_FAILSAFE}|g" \
    config/bootloaders/isolinux/raven-live.cfg.in > binary/isolinux/live.cfg
rm -f binary/isolinux/raven-live.cfg.in